# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
LOG_LEVEL=debug
# Swagger UI at /api/docs (set false in production if docs should not be public)
SWAGGER_ENABLED=true
# Shown in GEN-12 and GEN-99 messages (CFG-75)
SUPPORT_EMAIL=support@creativehandoffhub.in

# ---------- Database ----------
# Must be a replica set (transactions are required).
# Local: `docker compose up -d` gives you one at this address.
# Atlas: use the mongodb+srv://... string from the Atlas dashboard.
MONGODB_URI=mongodb://localhost:27017/chh?replicaSet=rs0

# ---------- Redis (cache, rate limits, BullMQ) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth (email OTP only; no Google sign-in) ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# 32-byte key, base64, used to encrypt review-link tokens so they can be copied again
LINK_TOKEN_ENCRYPTION_KEY=
COOKIE_DOMAIN=localhost

# ---------- Object storage (Cloudflare R2 / S3-compatible) ----------
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_QUARANTINE_BUCKET=

# ---------- Malware scanning ----------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---------- Email ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Creative Handoff Hub <no-reply@example.com>"

# ---------- Bot check (public transfer) ----------
TURNSTILE_SECRET_KEY=

# ---------- Payments ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Monitoring ----------
SENTRY_DSN=
